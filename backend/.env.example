# Copy this file to backend/.env (same folder) and fill in your key. NEVER commit .env.
# The key is read only by the Python backend; it is never sent to the browser.

GEMINI_API_KEY=
# Model id; check_gemini.py verifies it is available for your key.
GEMINI_MODEL=gemini-3.8-flash

# Optional
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_OUTPUT_TOKENS=2048
# GEMINI_THINKING_LEVEL=low
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LUNA_RATE_LIMIT_PER_MINUTE=20
# LUNA_HISTORY_TURNS=10
