# Copy to .env (never commit .env). Read ONLY by the Node pre-fetch script (npm run fetch-data), never by the app.

# --- NASA/JPL MUR SST v4.1 straight from PO.DAAC (preferred source for Ocean Symphony) ---
# MUR on NASA Earthdata Cloud needs an Earthdata Login. Create a free account at https://urs.earthdata.nasa.gov/,
# then Profile → Generate Token, and paste it here. With a token the script uses CMR (granule search) and
# OPeNDAP point subsets (one grid cell per sampled day). Without it, the script tries ERDDAP and then the
# clearly labelled NOAA Coral Reef Watch fallback.
# EARTHDATA_TOKEN=
# Pause between OPeNDAP requests in ms (default 300).
# MUR_DELAY_MS=300

# --- ERDDAP server used for MUR when no token is set (jplMURSST41, jplMURSST41anom1day). Default:
# ERDDAP_BASE=https://coastwatch.pfeg.noaa.gov/erddap
# Same, for live mode in the browser (Vite exposes only VITE_* variables; must be a public, no-login server):
# VITE_ERDDAP_BASE=https://coastwatch.pfeg.noaa.gov/erddap

# NEVER put Earthdata passwords or tokens in VITE_* variables: those are compiled into the public bundle.
# POWER, ORNL DAAC MODIS, CMR, GIBS and SVS are open and need no credentials.
